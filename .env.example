# ---------------------------------------------------------------------------
# Softronics: environment configuration
# Copy this file to .env.local and fill in real values. NEVER commit .env.local
# ---------------------------------------------------------------------------

# --- Site ------------------------------------------------------------------
# Canonical public URL. Used for canonical tags, sitemap.xml and OG metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public contact details shown on the website (safe to expose).
NEXT_PUBLIC_CONTACT_EMAIL=hello@softronics.example
# Optional. Leave empty to hide the WhatsApp option. Digits only, incl. country code.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# --- Supabase (database, auth, storage) ------------------------------------
# Project Settings -> API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Bypasses Row Level Security. Never prefix with NEXT_PUBLIC_.
# Used for: contact form inserts, admin provisioning scripts, seeding.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection string (Project Settings -> Database).
# Only needed if you run migrations with psql / a migration tool instead of the
# Supabase SQL editor or the Supabase CLI.
DATABASE_URL=

# Storage bucket used by the media library. Must be created as a PUBLIC bucket.
SUPABASE_STORAGE_BUCKET=media

# --- Auth ------------------------------------------------------------------
# Reserved for future non-Supabase auth adapters / signed tokens.
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Comma separated emails allowed to hold admin accounts. This is a second gate
# on top of the admin_users table in the database. Leave empty to rely on the DB only.
ADMIN_ALLOWED_EMAILS=otimg197@gmail.com,odan8897@gmail.com

# --- Email notifications (optional) ----------------------------------------
# Supported provider: resend. Leave EMAIL_PROVIDER empty to disable email and
# only store contact messages in the database.
EMAIL_PROVIDER=
RESEND_API_KEY=
# Must be a verified sender domain in your email provider.
EMAIL_FROM=Softronics <notifications@softronics.example>
# Where new contact-form submissions are delivered.
EMAIL_TO=
